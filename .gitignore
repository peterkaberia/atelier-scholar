# =========================
# Atelier Specific
# =========================
# Never commit your API keys or secrets!
.env
.env.local

# Ignore the local SQLite database (prevents committing user chat history and massive vector strings)
*.db*
*.sqlite3
*.sqlite

# Ignore Diskcache/Celery folders used for Dash Background Callbacks
cache/
diskcache/
celerybeat-schedule

# Ignore log files generated by the logger
*.log
logs/

# =========================
# Python
# =========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
venv/
env/
.venv/
.env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/

# Type checking
.mypy_cache/
.pyre/

# =========================
# OS & IDEs
# =========================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs (VS Code, PyCharm, etc.)
.vscode/
.idea/
*.swp
*.swo